# =============================================================================
# CPI Connect — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Or run the setup script which generates all secrets automatically:
#   bash docker/setup.sh
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────
# Connection string for PostgreSQL.
#
# LOCAL DEV: leave DATABASE_URL **unset** — instrumentation.ts auto-spawns an
# embedded PostgreSQL 18 cluster under .data/db on port 5435. No setup needed.
#
# DOCKER COMPOSE: this is set automatically inside the container.
#
# EXTERNAL POSTGRES: uncomment and point at your own server.
# DATABASE_URL=postgresql://cpiconnect:cpiconnect_secret@localhost:5432/cpiconnect

# Override embedded Postgres port / data dir (optional).
# EMBEDDED_PG_PORT=5435
# APP_DATA_DIR=./.data

# Docker Compose overrides
POSTGRES_PASSWORD=cpiconnect_secret
POSTGRES_DB=cpiconnect

# ── Encryption & Auth ────────────────────────────────────────────────────
# 32-byte AES-256 encryption key for SAP CPI credentials. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Better-Auth signing secret (used to sign session cookies / JWTs). Generate:
#   openssl rand -hex 32
# If unset, the app falls back to ENCRYPTION_KEY — do NOT rely on that in production.
BETTER_AUTH_SECRET=

# Secret for protecting cron trigger endpoints. Generate:
#   openssl rand -hex 16
CRON_SECRET=

# ── Application ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deployment mode: "self-hosted" (default, free) or "cloud" (paid tiers via Stripe)
NEXT_PUBLIC_DEPLOYMENT_MODE=self-hosted

# ── Ports (Docker) ───────────────────────────────────────────────────────
APP_PORT=3000
LITELLM_PORT=4000
DB_PORT=5432

# ── AI Provider ──────────────────────────────────────────────────────────
# "llmlite" (routes through LiteLLM proxy) or "google" (direct Google AI)
AI_PROVIDER=llmlite

# LiteLLM master key (used by docker-compose.yml and lib/ai-config.ts)
LITELLM_MASTER_KEY=sk-change-me

# Google Gemini API Key (required if AI_PROVIDER=google)
GOOGLE_API_KEY=

# LLMLite / OpenAI-compatible (when NOT using docker-compose.selfhost.yml)
LLMLITE_BASE_URL=
LLMLITE_API_KEY=

# Provider API keys for LiteLLM (set at least one for AI features):
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: Self-Hosted Limits ─────────────────────────────────────────
# Set these to enforce resource limits in self-hosted mode.
# Leave empty or omit for unlimited (default).
# SELF_HOSTED_AI_CALLS_LIMIT=1000
# SELF_HOSTED_MAX_TENANTS=
# SELF_HOSTED_MAX_IFLOWS=
# SELF_HOSTED_MAX_MEMBERS=

# ── Optional: SMTP (for sending emails in self-hosted) ──────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_ADMIN_EMAIL=admin@example.com
# SMTP_SENDER_NAME=CPI Connect

# ── Cloud-Only (not needed for self-hosted) ──────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PROFESSIONAL=
# STRIPE_PRICE_ENTERPRISE=
# RESEND_API_KEY=

# ── Corporate Network / SSL Inspection Fix ───────────────────────────────
# If you are running this app inside a corporate network that uses SSL
# inspection (man-in-the-middle proxy), outbound HTTPS calls to SAP CPI/APIM
# will fail with: "Error: self-signed certificate in certificate chain"
#
# HOW IT WORKS:
#   Setting CORPORATE_NETWORK=true activates lib/corporate-tls.ts at startup.
#   It patches Node.js's undici-based fetch() (used by Next.js server actions)
#   to use a custom TLS configuration. Add these to your .env file:
#
# ── Option 1: RECOMMENDED (secure) ──────────────────────────────────────
# Export your corporate CA certificate and point NODE_EXTRA_CA_CERTS to it.
#
#   Windows — export corporate CA cert:
#     1. Open Chrome → Settings → Privacy & Security → Security
#        → Manage certificates → Trusted Root Certification Authorities
#     2. Find your corporate root CA → Export
#        → Select "Base-64 encoded X.509 (.CER)" format
#     3. Save as corporate-ca.crt (e.g. C:\certs\corporate-ca.crt)
#     4. Set the path below (use forward slashes or double backslashes)
#
#   macOS — export corporate CA cert:
#     1. Open Keychain Access → System → Certificates
#     2. Find your corporate root CA → File → Export Items → .pem format
#
# CORPORATE_NETWORK=true
# NODE_EXTRA_CA_CERTS=C:/certs/corporate-ca.crt
#
# ── Option 2: FALLBACK (dev only, less secure) ───────────────────────────
# If you cannot obtain the corporate CA cert, disable TLS verification.
# This is safe only on trusted internal corporate networks.
#
# CORPORATE_NETWORK=true
#
# ── IMPORTANT ────────────────────────────────────────────────────────────
# NEVER set CORPORATE_NETWORK=true in production/cloud deployments.
# This setting is strictly for local development on corporate networks.
