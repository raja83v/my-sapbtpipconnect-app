
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id
  clerkId       String?    @unique // Clerk user ID for authentication
  email         String     @unique
  name          String?
  role          UserRole   @default(user)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  image         String?
  phone         String?
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt

  // Onboarding fields
  onboardingCompleted Boolean @default(false)
  onboardingData      Json?

  // Stripe billing fields
  stripeCustomerId     String?   @unique
  stripePriceId        String?
  stripeSubscriptionId String?   @unique
  stripeCurrentPeriodEnd DateTime?

  // Admin plugin fields (kept for compatibility, may deprecate)
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?

  // Relations
  sessions      Session[]
  accounts      Account[]
  tenants       TenantMember[]
  invitationsSent TenantInvitation[]
  agentExecutions AIAgentExecution[]
  subscription  Subscription?
  invoices      Invoice[]

  // Default tenant
  defaultTenantId String?
  defaultTenant   CpiTenant? @relation("UserDefaultTenant", fields: [defaultTenantId], references: [id], onDelete: SetNull)

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Active tenant context
  activeTenantId String?
  activeTenant   CpiTenant? @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)

  // Admin plugin field for impersonation
  impersonatedBy String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

// CPI Tenant model - represents SAP CPI tenant connections
model CpiTenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  
  // SAP CPI Connection Details
  tenantUrl         String   // e.g., https://example.it-cpi.cfapps.eu10.hana.ondemand.com
  authType          AuthType @default(OAUTH)
  authenticationUrl String?  // OAuth token endpoint URL
  clientId          String?
  clientSecret      String?  // Encrypted before storage
  tokenUrl          String?  // Deprecated - use authenticationUrl
  username          String?
  password          String?  // Encrypted before storage
  
  // Tenant Status
  status         TenantStatus @default(ACTIVE)
  lastSyncAt     DateTime?
  connectionTestAt DateTime?
  isConnected    Boolean @default(false)
  
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members     TenantMember[]
  invitations TenantInvitation[]
  sessions    Session[]
  defaultForUsers User[] @relation("UserDefaultTenant")
  iFlows      IFlow[]
  
  @@map("cpi_tenant")
}

// iFlow monitoring data
model IFlow {
  id              String   @id @default(cuid())
  iFlowId         String   // SAP CPI iFlow ID
  name            String
  packageName     String?
  version         String?
  status          IFlowStatus @default(STOPPED)
  lastDeployedAt  DateTime?
  lastExecutedAt  DateTime?
  
  // Relations
  tenantId    String
  tenant      CpiTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executions  IFlowExecution[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([tenantId, iFlowId])
  @@index([tenantId])
  @@index([status])
  @@index([updatedAt])
  @@index([tenantId, status])
  @@index([tenantId, updatedAt])
  @@map("iflow")
}

// iFlow execution logs
model IFlowExecution {
  id              String   @id @default(cuid())
  messageId       String   @unique // SAP CPI Message ID
  status          ExecutionStatus
  startTime       DateTime
  endTime         DateTime?
  duration        Int?     // in milliseconds
  
  // Payload data
  requestPayload  String?  @db.Text
  responsePayload String?  @db.Text
  errorMessage    String?  @db.Text
  errorCategory   ErrorCategory?
  
  // Metadata
  sender          String?
  receiver        String?
  interfaceType   String?  // Inbound/Outbound
  
  // Relations
  iFlowId     String
  iFlow       IFlow @relation(fields: [iFlowId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  
  @@index([iFlowId])
  @@index([status])
  @@index([startTime])
  @@map("iflow_execution")
}

// Junction table for user-tenant relationship
model TenantMember {
  id          String   @id @default(cuid())
  role        Role     @default(MEMBER)
  joinedAt    DateTime @default(now())

  // Relations
  userId      String
  tenantId    String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      CpiTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_member")
}

// Tenant invitation model
model TenantInvitation {
  id          String   @id @default(cuid())
  email       String
  role        Role     @default(MEMBER)
  token       String   @unique @default(cuid())
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())

  // Relations
  tenantId    String
  invitedById String
  tenant      CpiTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation(fields: [invitedById], references: [id])

  @@index([email])
  @@index([tenantId])
  @@map("tenant_invitation")
}

// Role enum for workspace members
enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// User role enum for application-wide permissions
enum UserRole {
  user
  admin
}

// User account status enum
enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// SAP CPI Tenant authentication types
enum AuthType {
  OAUTH
  BASIC_AUTH
  SERVICE_KEY
}

// Organization types for onboarding
enum OrganizationType {
  ENTERPRISE
  MID_MARKET
  STARTUP
  CONSULTING
  EDUCATION
  OTHER
}

// CPI Tenant status
enum TenantStatus {
  ACTIVE
  INACTIVE
  TESTING
  ERROR
}

// iFlow status
enum IFlowStatus {
  STARTED
  STOPPED
  STARTING
  STOPPING
  ERROR
}

// Execution status
enum ExecutionStatus {
  COMPLETED
  FAILED
  PROCESSING
  SKIPPED
  RETRY
}

// Error categories for debugging
enum ErrorCategory {
  SYSTEM
  NETWORK
  MAPPING
  SECURITY
  TIMEOUT
  BUSINESS_LOGIC
  UNKNOWN
}

// AI Agent execution tracking
model AIAgentExecution {
  id              String   @id @default(cuid())
  agentType       AIAgentType
  status          AIAgentStatus @default(RUNNING)
  
  // Input/Output
  inputPrompt     String   @db.Text
  outputData      String?  @db.Text
  errorMessage    String?  @db.Text
  
  // Performance metrics
  tokensUsed      Int      @default(0)
  duration        Int?     // in milliseconds
  
  // Context
  tenantId        String?
  iFlowId         String?
  
  // Relations
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId])
  @@index([tenantId])
  @@index([agentType])
  @@index([status])
  @@index([createdAt])
  @@map("ai_agent_execution")
}

// AI Agent types
enum AIAgentType {
  IFLOW_CREATOR
  SMART_MONITOR
  PERFORMANCE_OPTIMIZER
  ERROR_DIAGNOSTICIAN
  SECURITY_AUDITOR
  DOCUMENTATION_GENERATOR
  TEST_CASE_GENERATOR
  COST_ANALYZER
  PREDICTIVE_INSIGHTS
}

// AI Agent execution status
enum AIAgentStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// Subscription plan tiers
enum SubscriptionPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// Subscription status
enum SubscriptionStatus {
  ACTIVE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAST_DUE
  TRIALING
  UNPAID
  PAUSED
}

// Invoice status
enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

// User Subscription model
model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  
  // Stripe fields
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  stripeCurrentPeriodStart DateTime?
  stripeCurrentPeriodEnd   DateTime?
  
  // Usage limits based on plan
  maxTenants           Int                @default(1)
  maxIFlows            Int                @default(10)
  maxTeamMembers       Int                @default(3)
  maxAIAgentCalls      Int                @default(100)
  
  // Usage tracking
  currentTenantCount   Int                @default(0)
  currentIFlowCount    Int                @default(0)
  currentTeamMemberCount Int              @default(0)
  currentAIAgentCalls  Int                @default(0)
  
  // Trial info
  trialStart           DateTime?
  trialEnd             DateTime?
  
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@map("subscription")
}

// Invoice model for billing history
model Invoice {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  stripeInvoiceId    String        @unique
  stripePaymentIntentId String?
  
  amountPaid         Int           // in cents
  amountDue          Int           // in cents
  currency           String        @default("usd")
  status             InvoiceStatus @default(DRAFT)
  
  invoiceUrl         String?
  invoicePdf         String?
  hostedInvoiceUrl   String?
  
  periodStart        DateTime?
  periodEnd          DateTime?
  paidAt             DateTime?
  
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  
  @@index([userId])
  @@index([stripeInvoiceId])
  @@map("invoice")
}
