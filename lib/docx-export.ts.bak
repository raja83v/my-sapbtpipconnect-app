/**
 * DOCX Export Utility
 *
 * Converts a GeneratedDocument into a professionally formatted .docx file
 * using the `docx` library. Runs client-side in the browser.
 */

import {
  Document,
  Paragraph,
  TextRun,
  HeadingLevel,
  AlignmentType,
  TableOfContents,
  StyleLevel,
  PageBreak,
  Table,
  TableRow,
  TableCell,
  WidthType,
  BorderStyle,
  Packer,
  ShadingType,
  type ITableCellOptions,
} from "docx";
import type { GeneratedDocument, MermaidDiagram } from "@/types/documentation-generator";
import { getDocumentTypeTitle } from "@/types/documentation-generator";

// ============================================================================
// Main Export Function
// ============================================================================

export async function generateDocx(generatedDoc: GeneratedDocument): Promise<Blob> {
  const doc = new Document({
    creator: "SAP CPI Connect — Documentation Generator",
    title: generatedDoc.title,
    description: `${getDocumentTypeTitle(generatedDoc.type)} for ${generatedDoc.iflowName}`,
    styles: {
      default: {
        document: {
          run: { font: "Calibri", size: 22 }, // 11pt
          paragraph: { spacing: { after: 120 } },
        },
        heading1: {
          run: { font: "Calibri", size: 36, bold: true, color: "1F4E79" },
          paragraph: { spacing: { before: 360, after: 200 } },
        },
        heading2: {
          run: { font: "Calibri", size: 30, bold: true, color: "2E75B6" },
          paragraph: { spacing: { before: 280, after: 160 } },
        },
        heading3: {
          run: { font: "Calibri", size: 26, bold: true, color: "404040" },
          paragraph: { spacing: { before: 200, after: 120 } },
        },
      },
    },
    features: { updateFields: true },
    sections: [
      // Cover Page
      buildCoverPage(generatedDoc),
      // Table of Contents
      buildTocSection(),
      // Document Body
      buildBodySection(generatedDoc),
    ],
  });

  return Packer.toBlob(doc);
}

// ============================================================================
// Cover Page
// ============================================================================

function buildCoverPage(doc: GeneratedDocument) {
  return {
    properties: {},
    children: [
      // Spacer
      ...Array.from({ length: 6 }, () =>
        new Paragraph({ text: "", spacing: { after: 200 } })
      ),
      // Title
      new Paragraph({
        alignment: AlignmentType.CENTER,
        spacing: { after: 200 },
        children: [
          new TextRun({
            text: doc.title,
            bold: true,
            size: 56,
            font: "Calibri",
            color: "1F4E79",
          }),
        ],
      }),
      // Subtitle — doc type
      new Paragraph({
        alignment: AlignmentType.CENTER,
        spacing: { after: 120 },
        children: [
          new TextRun({
            text: getDocumentTypeTitle(doc.type),
            size: 32,
            font: "Calibri",
            color: "2E75B6",
          }),
        ],
      }),
      // Horizontal rule (via border)
      new Paragraph({
        alignment: AlignmentType.CENTER,
        spacing: { before: 300, after: 300 },
        border: {
          bottom: { style: BorderStyle.SINGLE, size: 6, color: "2E75B6" },
        },
        children: [],
      }),
      // Metadata table
      buildMetadataTable(doc),
      // Spacer
      ...Array.from({ length: 4 }, () =>
        new Paragraph({ text: "", spacing: { after: 200 } })
      ),
      // Footer text
      new Paragraph({
        alignment: AlignmentType.CENTER,
        children: [
          new TextRun({
            text: "Generated by SAP CPI Connect — Documentation Generator",
            italics: true,
            size: 20,
            color: "808080",
          }),
        ],
      }),
    ],
  };
}

function buildMetadataTable(doc: GeneratedDocument) {
  const rows: [string, string][] = [
    ["iFlow Name", doc.iflowName],
    ["Version", doc.version],
    ["Document Type", getDocumentTypeTitle(doc.type)],
    ["Sections", `${doc.sections.length}`],
    ["Diagrams", `${doc.diagrams.length}`],
    ["Generated", new Date(doc.generatedAt).toLocaleString()],
  ];

  const cellOptions = (shaded: boolean): Partial<ITableCellOptions> => ({
    width: { size: 50, type: WidthType.PERCENTAGE },
    shading: shaded
      ? { type: ShadingType.SOLID, color: "F2F7FB", fill: "F2F7FB" }
      : undefined,
    margins: { top: 60, bottom: 60, left: 120, right: 120 },
  });

  return new Table({
    alignment: AlignmentType.CENTER,
    width: { size: 70, type: WidthType.PERCENTAGE },
    rows: rows.map(
      ([label, value], i) =>
        new TableRow({
          children: [
            new TableCell({
              ...cellOptions(i % 2 === 0),
              children: [
                new Paragraph({
                  children: [
                    new TextRun({ text: label, bold: true, size: 22, color: "1F4E79" }),
                  ],
                }),
              ],
            }),
            new TableCell({
              ...cellOptions(i % 2 === 0),
              children: [
                new Paragraph({
                  children: [new TextRun({ text: value, size: 22 })],
                }),
              ],
            }),
          ],
        })
    ),
  });
}

// ============================================================================
// Table of Contents
// ============================================================================

function buildTocSection() {
  return {
    properties: {},
    children: [
      new Paragraph({
        heading: HeadingLevel.HEADING_1,
        children: [new TextRun({ text: "Table of Contents" })],
      }),
      new TableOfContents("Table of Contents", {
        hyperlink: true,
        headingStyleRange: "1-3",
        stylesWithLevels: [
          new StyleLevel("Heading1", 1),
          new StyleLevel("Heading2", 2),
          new StyleLevel("Heading3", 3),
        ],
      }),
      new Paragraph({
        children: [new PageBreak()],
      }),
    ],
  };
}

// ============================================================================
// Body Sections
// ============================================================================

function buildBodySection(doc: GeneratedDocument) {
  const children: Paragraph[] = [];

  // Render each section
  for (const section of doc.sections) {
    children.push(
      new Paragraph({
        heading: HeadingLevel.HEADING_1,
        children: [new TextRun({ text: section.title })],
      })
    );

    // Parse markdown content into paragraphs
    const paragraphs = markdownToParagraphs(section.content);
    children.push(...paragraphs);
  }

  // Render diagrams section if present
  if (doc.diagrams.length > 0) {
    children.push(
      new Paragraph({
        heading: HeadingLevel.HEADING_1,
        children: [new TextRun({ text: "Diagrams" })],
      })
    );

    for (const diagram of doc.diagrams) {
      children.push(...renderDiagram(diagram));
    }
  }

  return {
    properties: {},
    children,
  };
}

// ============================================================================
// Markdown → DOCX Paragraph Conversion
// ============================================================================

function markdownToParagraphs(markdown: string): Paragraph[] {
  const paragraphs: Paragraph[] = [];
  const lines = markdown.split("\n");
  let i = 0;

  while (i < lines.length) {
    const line = lines[i];

    // Skip empty lines
    if (line.trim() === "") {
      i++;
      continue;
    }

    // Code block (``` ... ```)
    if (line.trim().startsWith("```")) {
      const codeLines: string[] = [];
      i++; // skip opening ```
      while (i < lines.length && !lines[i].trim().startsWith("```")) {
        codeLines.push(lines[i]);
        i++;
      }
      i++; // skip closing ```
      paragraphs.push(
        new Paragraph({
          shading: { type: ShadingType.SOLID, color: "F5F5F5", fill: "F5F5F5" },
          spacing: { before: 120, after: 120 },
          children: codeLines.map(
            (codeLine, idx) =>
              new TextRun({
                text: (idx > 0 ? "\n" : "") + codeLine,
                font: "Consolas",
                size: 18,
                color: "333333",
                break: idx > 0 ? 1 : undefined,
              })
          ),
        })
      );
      continue;
    }

    // Headings
    const headingMatch = line.match(/^(#{1,6})\s+(.+)/);
    if (headingMatch) {
      const level = headingMatch[1].length;
      const text = headingMatch[2].replace(/[*_`]/g, "");
      const heading =
        level <= 1
          ? HeadingLevel.HEADING_2 // Subsections under section H1
          : level === 2
            ? HeadingLevel.HEADING_3
            : HeadingLevel.HEADING_3;
      paragraphs.push(
        new Paragraph({
          heading,
          children: [new TextRun({ text })],
        })
      );
      i++;
      continue;
    }

    // Table (lines starting with |)
    if (line.trim().startsWith("|")) {
      const tableLines: string[] = [];
      while (i < lines.length && lines[i].trim().startsWith("|")) {
        tableLines.push(lines[i]);
        i++;
      }
      const table = parseMarkdownTable(tableLines);
      if (table) {
        paragraphs.push(
          new Paragraph({ spacing: { before: 120 }, children: [] })
        );
        // Tables can't be mixed into Paragraph[], they need to be added differently.
        // Since we return Paragraph[], we'll render table rows as tab-separated paragraphs.
        for (const row of table) {
          paragraphs.push(
            new Paragraph({
              spacing: { after: 40 },
              children: row.map(
                (cell, idx) =>
                  new TextRun({
                    text: (idx > 0 ? "    |    " : "") + cell,
                    size: 20,
                    font: "Calibri",
                  })
              ),
            })
          );
        }
        paragraphs.push(
          new Paragraph({ spacing: { after: 120 }, children: [] })
        );
        continue;
      }
    }

    // Unordered list (- or *)
    const ulMatch = line.match(/^(\s*)[-*]\s+(.+)/);
    if (ulMatch) {
      const indent = Math.floor((ulMatch[1].length || 0) / 2);
      paragraphs.push(
        new Paragraph({
          indent: { left: 360 + indent * 360 },
          bullet: { level: indent },
          children: parseInlineFormatting(ulMatch[2]),
        })
      );
      i++;
      continue;
    }

    // Ordered list (1. 2. etc.)
    const olMatch = line.match(/^(\s*)\d+\.\s+(.+)/);
    if (olMatch) {
      const indent = Math.floor((olMatch[1].length || 0) / 2);
      paragraphs.push(
        new Paragraph({
          indent: { left: 360 + indent * 360 },
          numbering: { reference: "default-numbering", level: indent },
          children: parseInlineFormatting(olMatch[2]),
        })
      );
      i++;
      continue;
    }

    // Horizontal rule
    if (/^(-{3,}|_{3,}|\*{3,})$/.test(line.trim())) {
      paragraphs.push(
        new Paragraph({
          spacing: { before: 200, after: 200 },
          border: {
            bottom: { style: BorderStyle.SINGLE, size: 3, color: "CCCCCC" },
          },
          children: [],
        })
      );
      i++;
      continue;
    }

    // Blockquote
    if (line.trim().startsWith(">")) {
      const text = line.replace(/^>\s*/, "");
      paragraphs.push(
        new Paragraph({
          indent: { left: 480 },
          border: {
            left: { style: BorderStyle.SINGLE, size: 6, color: "2E75B6" },
          },
          spacing: { before: 80, after: 80 },
          children: [
            new TextRun({
              text,
              italics: true,
              color: "555555",
              size: 22,
            }),
          ],
        })
      );
      i++;
      continue;
    }

    // Regular paragraph
    paragraphs.push(
      new Paragraph({
        spacing: { after: 120 },
        children: parseInlineFormatting(line),
      })
    );
    i++;
  }

  return paragraphs;
}

// ============================================================================
// Inline Formatting  (**bold**, *italic*, `code`, etc.)
// ============================================================================

function parseInlineFormatting(text: string): TextRun[] {
  const runs: TextRun[] = [];
  // Regex to match bold, italic, code, bold+italic
  const regex = /(\*\*\*(.+?)\*\*\*|\*\*(.+?)\*\*|\*(.+?)\*|`(.+?)`)/g;
  let lastIndex = 0;
  let match: RegExpExecArray | null;

  while ((match = regex.exec(text)) !== null) {
    // Text before the match
    if (match.index > lastIndex) {
      runs.push(new TextRun({ text: text.slice(lastIndex, match.index), size: 22 }));
    }

    if (match[2]) {
      // Bold + Italic (***text***)
      runs.push(new TextRun({ text: match[2], bold: true, italics: true, size: 22 }));
    } else if (match[3]) {
      // Bold (**text**)
      runs.push(new TextRun({ text: match[3], bold: true, size: 22 }));
    } else if (match[4]) {
      // Italic (*text*)
      runs.push(new TextRun({ text: match[4], italics: true, size: 22 }));
    } else if (match[5]) {
      // Inline code (`text`)
      runs.push(
        new TextRun({
          text: match[5],
          font: "Consolas",
          size: 20,
          color: "C7254E",
          shading: { type: ShadingType.SOLID, color: "F9F2F4", fill: "F9F2F4" },
        })
      );
    }

    lastIndex = match.index + match[0].length;
  }

  // Remaining text
  if (lastIndex < text.length) {
    runs.push(new TextRun({ text: text.slice(lastIndex), size: 22 }));
  }

  if (runs.length === 0) {
    runs.push(new TextRun({ text, size: 22 }));
  }

  return runs;
}

// ============================================================================
// Markdown Table Parser
// ============================================================================

function parseMarkdownTable(lines: string[]): string[][] | null {
  if (lines.length < 2) return null;

  const rows: string[][] = [];
  for (const line of lines) {
    const trimmed = line.trim();
    // Skip separator row (|---|---|)
    if (/^\|[\s-:|]+\|$/.test(trimmed)) continue;

    const cells = trimmed
      .replace(/^\|/, "")
      .replace(/\|$/, "")
      .split("|")
      .map((c) => c.trim());
    rows.push(cells);
  }
  return rows.length > 0 ? rows : null;
}

// ============================================================================
// Diagram Rendering (as styled code block since Mermaid can't render in .docx)
// ============================================================================

function renderDiagram(diagram: MermaidDiagram): Paragraph[] {
  return [
    new Paragraph({
      heading: HeadingLevel.HEADING_2,
      children: [new TextRun({ text: diagram.title })],
    }),
    new Paragraph({
      spacing: { after: 80 },
      children: [
        new TextRun({
          text: `Diagram Type: ${diagram.type}`,
          italics: true,
          color: "808080",
          size: 20,
        }),
      ],
    }),
    // Mermaid code as styled code block
    new Paragraph({
      shading: { type: ShadingType.SOLID, color: "F0F4F8", fill: "F0F4F8" },
      border: {
        left: { style: BorderStyle.SINGLE, size: 6, color: "2E75B6" },
      },
      spacing: { before: 80, after: 80 },
      children: [
        new TextRun({
          text: "📊 Mermaid Diagram (paste into any Mermaid renderer):",
          bold: true,
          size: 20,
          color: "2E75B6",
        }),
      ],
    }),
    ...diagram.mermaidCode.split("\n").map(
      (line, idx) =>
        new Paragraph({
          shading: { type: ShadingType.SOLID, color: "F8F8F8", fill: "F8F8F8" },
          spacing: { after: 0 },
          indent: { left: 240 },
          children: [
            new TextRun({
              text: line,
              font: "Consolas",
              size: 18,
              color: "333333",
              break: idx > 0 ? undefined : undefined,
            }),
          ],
        })
    ),
    new Paragraph({ spacing: { after: 200 }, children: [] }),
  ];
}
